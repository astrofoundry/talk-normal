{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/always-on.mjs"],
            "timeout": 5,
            "statusMessage": "Loading talk-normal ruleset..."
          }
        ]
      }
    ]
  }
}
